<Window x:Class="BattWatch.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BattWatch.UI"
        Title="电量哨兵" Width="860" Height="560" MinWidth="640" MinHeight="420"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <StackPanel Margin="8,14,8,8">
            <TextBlock Text="电量哨兵" FontSize="15" FontWeight="SemiBold" Margin="14,0,0,16"/>
            <RadioButton x:Name="NavDevices" Style="{StaticResource NavButton}" Tag="&#xE702;" Content="设备电量" IsChecked="True" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavHistory" Style="{StaticResource NavButton}" Tag="&#xE9D2;" Content="历史统计" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="&#xE713;" Content="设置" Checked="Nav_Checked"/>
        </StackPanel>

        <Border Grid.Column="1" Background="#F9F9F9" BorderBrush="{StaticResource CardBorder}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <Grid Margin="24,18,24,16">

                <!-- ============ Devices ============ -->
                <Grid x:Name="PageDevices">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Click="Refresh_Click" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="刷新"/>
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="设备电量" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DevicesSummary" Foreground="{StaticResource SubText}" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl x:Name="DeviceList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ui:DeviceView}">
                                        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                                CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="隐藏此设备" Click="HideDevice_Click" Tag="{Binding Model.Id}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="86"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="22" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Right" Background="{Binding BadgeBrush}" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="{Binding BadgeText}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                    <ProgressBar Value="{Binding Level, Mode=OneWay}" Maximum="100" Height="4" Margin="0,8,0,6"
                                                                 Foreground="{Binding BarBrush}" Background="{StaticResource Track}" BorderThickness="0"/>
                                                    <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{StaticResource SubText}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{StaticResource Good}"
                                                               VerticalAlignment="Center" Margin="0,0,4,0" Visibility="{Binding ChargingVisibility}" ToolTip="充电中"/>
                                                    <TextBlock Text="{Binding LevelText}" FontSize="22" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="EmptyHint" TextWrapping="Wrap" Foreground="{StaticResource SubText}" Margin="2,8" Visibility="Collapsed"
                                       Text="还没有读到任何设备的电量。蓝牙设备需要已配对且处于连接状态；MCHOSE 2.4G 鼠标是在电量变化时主动上报，首次可能需要等几分钟（拔插接收器、或让鼠标休眠后再唤醒可以更快触发）。"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ============ History ============ -->
                <Grid x:Name="PageHistory" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="历史统计" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <DockPanel Grid.Row="1" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <RadioButton x:Name="Range24h" Content="24 小时" GroupName="range" IsChecked="True" Margin="0,0,10,0" Checked="Range_Checked"/>
                            <RadioButton x:Name="Range7d" Content="7 天" GroupName="range" Margin="0,0,10,0" Checked="Range_Checked"/>
                            <RadioButton x:Name="Range30d" Content="30 天" GroupName="range" Checked="Range_Checked"/>
                        </StackPanel>
                        <ComboBox x:Name="HistoryDevice" Width="260" HorizontalAlignment="Left" DisplayMemberPath="Value" SelectedValuePath="Key"
                                  SelectionChanged="HistoryDevice_SelectionChanged"/>
                    </DockPanel>
                    <Border Grid.Row="2" Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="8">
                        <ui:LineChart x:Name="Chart"/>
                    </Border>
                    <UniformGrid Grid.Row="3" Columns="4" Margin="0,10,0,0">
                        <StackPanel><TextBlock Text="当前" Foreground="{StaticResource SubText}" FontSize="11"/><TextBlock x:Name="StatNow" FontSize="18" FontWeight="SemiBold" Text="—"/></StackPanel>
                        <StackPanel><TextBlock Text="区间最低" Foreground="{StaticResource SubText}" FontSize="11"/><TextBlock x:Name="StatMin" FontSize="18" FontWeight="SemiBold" Text="—"/></StackPanel>
                        <StackPanel><TextBlock Text="平均耗电" Foreground="{StaticResource SubText}" FontSize="11"/><TextBlock x:Name="StatRate" FontSize="18" FontWeight="SemiBold" Text="—"/></StackPanel>
                        <StackPanel><TextBlock Text="预计可用" Foreground="{StaticResource SubText}" FontSize="11"/><TextBlock x:Name="StatEta" FontSize="18" FontWeight="SemiBold" Text="—"/></StackPanel>
                    </UniformGrid>
                </Grid>

                <!-- ============ Settings ============ -->
                <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="设置" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14"/>

                        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" x:Name="ThresholdText" FontWeight="SemiBold"/>
                                    <TextBlock Text="低电量提醒阈值"/>
                                </DockPanel>
                                <Slider x:Name="Threshold" Minimum="5" Maximum="50" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,8,0,0"
                                        ValueChanged="Threshold_ValueChanged"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                            <DockPanel>
                                <ComboBox x:Name="PollInterval" DockPanel.Dock="Right" Width="110" SelectionChanged="PollInterval_SelectionChanged">
                                    <ComboBoxItem Content="30 秒" Tag="30"/>
                                    <ComboBoxItem Content="1 分钟" Tag="60"/>
                                    <ComboBoxItem Content="3 分钟" Tag="180"/>
                                    <ComboBoxItem Content="5 分钟" Tag="300"/>
                                </ComboBox>
                                <TextBlock Text="刷新间隔" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                            <StackPanel>
                                <CheckBox x:Name="AutoStart" Content="开机自动启动（最小化到托盘）" Margin="0,2" Click="AutoStart_Click"/>
                                <CheckBox x:Name="ShowLaptop" Content="监控笔记本自身电池" Margin="0,6,0,2" Click="ShowLaptop_Click"/>
                                <CheckBox x:Name="ShowWidget" Content="显示桌面悬浮小组件" Margin="0,6,0,2" Click="ShowWidget_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="已隐藏的设备"/>
                                <TextBlock x:Name="HiddenEmpty" Text="无（在设备卡片上右键可隐藏）" Foreground="{StaticResource SubText}" FontSize="12" Margin="0,6,0,0"/>
                                <ItemsControl x:Name="HiddenList" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Padding="8,2" Content="取消隐藏" Tag="{Binding Key}" Click="Unhide_Click"/>
                                                <TextBlock Text="{Binding Value}" FontSize="12" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource FlatButton}" Content="打开数据文件夹" Click="OpenData_Click" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource FlatButton}" Content="清空历史记录…" Click="ClearHistory_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
